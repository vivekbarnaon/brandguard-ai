DATABASE_URL=postgresql+asyncpg://postgres:password@db.example.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Required only for legacy HS256 projects. Leave empty for asymmetric/JWKS signing.
SUPABASE_JWT_SECRET=
FRONTEND_URL=http://localhost:3000
AIML_SERVICE_URL=http://localhost:8001
AIML_ANALYZE_PATH=/analyze
AIML_SUGGESTIONS_PATH=/suggestions
AIML_PROCESS_PATH=/process-document
AIML_RETRIEVE_PATH=/retrieve-guidelines
# Required by the protected AIML evidence callback.
AIML_INTERNAL_TOKEN=
STORAGE_BUCKET=brand-guidelines
MAX_UPLOAD_BYTES=10485760
# AI/ML credentials are server-side only and may be consumed by the internal
# AIML process when it is launched with backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=brand_guidelines

